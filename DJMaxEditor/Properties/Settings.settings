      <Value Profile="(Default)">False</Value>
    </Setting>
    <Setting Name="PreviewSpriteStyle" Type="System.String" Scope="User">
      <Value Profile="(Default)">auto</Value>
    </Setting>
    <Setting Name="Technika3AssetPath" Type="System.String" Scope="User">
      <Value Profile="(Default)" />
    </Setting>
  </Settings>
